# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=https://futurvion.in
NEXT_PUBLIC_BUSINESS_EMAIL=hello@your-domain.com
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# PostgreSQL connection string; enables leads, rate limiting and analytics
DATABASE_URL=postgresql://user:password@host:5432/futurvion
# Random string of 32+ characters used to pseudonymise visitors/IPs (e.g. `openssl rand -hex 32`)
ABUSE_HASH_SECRET=
# Resend transactional email (contact notifications)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
