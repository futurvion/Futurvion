# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_BUSINESS_EMAIL=hello@your-domain.example
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# PostgreSQL connection string; enables leads, rate limiting and analytics
DATABASE_URL=postgresql://user:password@host:5432/futurvion
# Optional direct connection for Prisma migrations; DATABASE_URL can remain pooled.
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:3000
ADMIN_EMAIL=futurvion@gmail.com
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
JOB_SYNC_SECRET=
# Random string of 32+ characters used for contact/analytics and guest resume-search rate limits.
# Resume matching requires this value; never expose it to the browser.
ABUSE_HASH_SECRET=
# Resend transactional email (contact notifications)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must use a sending domain verified in the Resend dashboard.
CONTACT_FROM_EMAIL=
